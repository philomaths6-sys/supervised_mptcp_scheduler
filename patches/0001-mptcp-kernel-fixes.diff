+Time
+MpTcpSubflow::GetRttEstimate (void) const
+{
+  if (m_rtt)
+    {
+      Time est = m_rtt->GetEstimate ();
+      if (est.GetMilliSeconds () > 0)
+        {
+          return est;
+        }
+    }
+  if (m_tcb && m_tcb->m_lastRtt.Get ().GetMilliSeconds () > 0)
+    {
+      return m_tcb->m_lastRtt.Get ();
+    }
+  return MilliSeconds (20);
+}
+
+Time
+MpTcpSubflow::GetMinRtt (void) const
+{
+  if (m_tcb && m_tcb->m_minRtt != Time::Max ())
+    {
+      return m_tcb->m_minRtt;
+    }
+  return GetRttEstimate ();
+}
+
+uint32_t
+MpTcpSubflow::GetCwnd (void) const
+{
+  if (m_tcb)
+    {
+      return m_tcb->m_cWnd;
+    }
+  return 1440 * 10;
+}
